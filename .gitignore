# webvnc 项目的忽略规则
# 说明见文件末尾：frontend/dist 是构建产物，不入库。

# ---------------------------------------------------------------------------
# Go 编译产物
# ---------------------------------------------------------------------------
# build.ps1 / build.sh 的默认输出，以及手动 go build 常见的写法
/webvnc
/webvnc.exe
/webvnc-dev
/webvnc-dev.exe
/mfprobe
/mfprobe.exe

# 任何位置的 Windows 可执行文件和 Go 测试二进制
*.exe
*.test

# 覆盖率 / profile 输出
*.out
coverage.*
profile.cov

# ---------------------------------------------------------------------------
# 前端
# ---------------------------------------------------------------------------
# 依赖目录。package-lock.json 要入库，node_modules 不要。
frontend/node_modules/

# npm run build 的产物。go:embed 在编译期读取它，所以每次构建前重新生成，
# 不需要（也不应该）提交到仓库。
frontend/dist/

# 构建工具缓存与类型检查增量信息
frontend/.vite/
frontend/node_modules/.vite-temp/
*.tsbuildinfo

# 包管理器日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# 编辑器 / IDE
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code 的本地会话配置（共享配置 .claude/settings.json 仍可入库）
.claude/settings.local.json

# ---------------------------------------------------------------------------
# 操作系统
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# 运行时产物
# ---------------------------------------------------------------------------
*.log
